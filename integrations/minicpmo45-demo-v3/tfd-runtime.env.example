# Copy outside Git, set your local asset paths, then source this file.
export TFD_PROJECT_ROOT=/path/to/trusted-full-duplex-agent
export TFD_DEMO_ROOT=/path/to/MiniCPM-o-Demo
export PYTHONPATH="$TFD_PROJECT_ROOT/src:$TFD_DEMO_ROOT"
export TFD_GRPO_ADAPTER=/path/to/release-grpo-adapter
export TFD_GRPO_ADAPTER_NAME=tfd_grpo
export TFD_TURN_MLP_ENABLED=1
export TFD_TURN_MLP_WEIGHTS=/path/to/learned_mlp.pt
export TFD_TURN_FRAME_MS=100
export TFD_TURN_CONFIRM_FRAMES=4
export TFD_TRUST_GATE_ENABLED=1
export TFD_GATE_CONFIG="$TFD_PROJECT_ROOT/configs/gate.yaml"
export TFD_ASR_MODEL=/path/to/faster-whisper-small
export TFD_ASR_DEVICE=cpu
export TFD_ASR_COMPUTE_TYPE=int8
export TFD_ASR_LANGUAGE=zh
export TFD_COMPILE_AFTER_ADAPTER=1
export TFD_COMPILE_LLM_AFTER_ADAPTER=0
export TFD_DEMO_V3_PROFILES=1
export TFD_RESPONSE_TRACKING_ONLY=1
export TFD_RESPONSE_LIFECYCLE=0
export TFD_CONTROLLED_NEAR_END_REPLAY=0
export TFD_TURN_WAIT_MODE=off
export TFD_TURN_WAIT_PROMPT_APPEND=0
unset TFD_NATIVE_ACTION_HEAD
# Optional assets: enable a profile only after provisioning its actual checkpoints.
# export TFD_SHADOW_HEAD_DIRECTORY=/path/to/four-action-heads
# export TFD_LORA_PROFILE_MANIFEST=/path/to/adapter_manifest.json
# export TFD_COMPONENT_OBSERVER_URL=http://127.0.0.1:22680
