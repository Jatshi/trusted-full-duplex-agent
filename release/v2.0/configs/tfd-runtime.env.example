# TFD-STAR 2.0 optional runtime layers
# Copy this file outside Git and edit the absolute paths.

export TFD_PROJECT_ROOT=/root/autodl-tmp/trusted-full-duplex-agent

# GRPO adapter. Unset to run the exact upstream/base-model comparison.
export TFD_GRPO_ADAPTER=/root/autodl-tmp/trusted-full-duplex-agent/outputs/rl_ckpt_minicpmo9b_lr1e5
export TFD_GRPO_ADAPTER_NAME=tfd_grpo

# Compile after adapter attachment. TTS-only is the measured default.
export TFD_COMPILE_AFTER_ADAPTER=1
export TFD_COMPILE_LLM_AFTER_ADAPTER=0

# External turn-taking MLP.
export TFD_TURN_MLP_ENABLED=1
export TFD_TURN_MLP_WEIGHTS=/root/autodl-tmp/trusted-full-duplex-agent/outputs/turntaking/learned_mlp.pt
export TFD_TURN_FRAME_MS=100
export TFD_TURN_CONFIRM_FRAMES=4
export TFD_TURN_MIN_VOICED_FRAMES=3
export TFD_TURN_MIN_SILENCE_FRAMES=4
export TFD_TURN_VAD_DB=-38

# ASR-backed TrustGate safety monitor. CPU int8 preserves GPU headroom.
export TFD_TRUST_GATE_ENABLED=1
export TFD_GATE_CONFIG=/root/autodl-tmp/trusted-full-duplex-agent/configs/gate.yaml
export TFD_ASR_MODEL=/root/autodl-tmp/trusted-full-duplex-agent/weights/faster-whisper-small
export TFD_ASR_DEVICE=cpu
export TFD_ASR_COMPUTE_TYPE=int8
export TFD_ASR_LANGUAGE=zh
export TFD_ASR_BEAM_SIZE=1
export TFD_ASR_MAX_AUDIO_SECONDS=12
